{
  "name": "waseemilyas-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Waseem Ilyas — static site built with Eleventy (WI-PF1).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-concurrency=1 --test-global-setup=scripts/test-setup.mjs \"scripts/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint src scripts eleventy.config.js",
    "typecheck": "tsrs --noEmit"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "oxlint": "1.94.0",
    "parse5": "8.1.1",
    "tsrs": "7.1.0-beta.tsrs3"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
