<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="strict-origin-when-cross-origin">
<script>(function(d,r){d.className+=' js';if(location.hash.length>1)d.className+=' deeplink';try{if(r&&new URL(r).origin===location.origin)d.className+=' onsite';}catch(e){}})(document.documentElement,document.referrer);</script>

{% set pageTitle = title if title else site.shortTitle %}
{% set fullTitle = pageTitle + " — " + site.shortTitle if title and page.url != "/" else site.title %}
{% set pageDesc = description if description else site.description %}
{% set canonical = site.url + page.url %}
{#- The share-card transform fills article image metadata from the rendered page. #}
{% set ogImage = site.url + site.ogImage %}
{% set ogImageAlt = site.ogImageAlt %}
{% set isNote = "note" in (tags or []) %}

<title>{{ fullTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="author" content="{{ site.author }}">
<meta name="waseemilyas-revision" content="{{ siteRevision }}">
<meta name="theme-color" content="#2b2622">

<!-- Open Graph -->
<meta property="og:type" content="{{ "article" if isNote else "website" }}">
<meta property="og:site_name" content="{{ site.shortTitle }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt }}">
{%- if isNote %}
<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:author" content="{{ site.url }}/about/">
{%- endif %}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImage }}">
<meta name="twitter:image:alt" content="{{ ogImageAlt }}">

<!-- Icons -->
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Fonts: self-hosted, preloaded -->
<link rel="preload" href="/assets/fonts/Geist-Core.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/GeistMono-Core.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/styles.css">
<link rel="alternate" type="application/atom+xml" title="{{ site.shortTitle }} — Notes" href="/notes/feed.xml">

{% if monitoring.sentrySdkUrl %}
<!-- Error monitoring is configured only in production builds via SENTRY_DSN.
     Nothing third-party loads on a normal visit: the pinned Sentry SDK is served
     from this site and downloaded only after the first error, which is held and
     reported once it arrives, together with any that follow. -->
<script>
  (function () {
    var held = [];
    var loading = false;
    var send = function (item) { typeof item === "function" ? item() : Sentry.captureException(item); };
    var onError = function (e) { report(e.error || e.message); };
    var onRejection = function (e) { report(e.reason); };
    var canonicalPage = document.querySelector('link[rel="canonical"]').href;
    var sdkUrl = "{{ monitoring.sentrySdkUrl }}";
    var errorTypes = new Set([
      "Error", "AggregateError", "EvalError", "RangeError", "ReferenceError", "SyntaxError",
      "TypeError", "URIError", "AbortError", "InvalidStateError", "NotAllowedError",
      "NotSupportedError", "QuotaExceededError", "SecurityError", "UnhandledRejection"
    ]);
    // Trusted Types: the page policy refuses plain strings as script URLs, so the loader
    // has one named policy that vouches for the pinned SDK and nothing else.
    var sdkPolicy = window.trustedTypes && trustedTypes.createPolicy("sdk-loader", {
      createScriptURL: function (url) {
        if (url !== sdkUrl) throw new TypeError("sdk-loader allows only the pinned SDK");
        return url;
      }
    });

    function sourceFile(filename) {
      try {
        var url = new URL(filename);
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname) return canonicalPage;
        if (url.pathname === "/assets/js/site.js") return url.origin + url.pathname;
      } catch (e) {
        // Native and anonymous frames need no URL.
      }
    }

    function minimizeReport(event) {
      // Use the published page even when GitHub Pages serves the 404 at a visitor's URL.
      event.request = { url: canonicalPage };
      delete event.breadcrumbs;
      delete event.extra; // The SDK can attach callback arguments or rejected objects.
      if (event.exception) {
        // Exception text, custom names and stack labels can contain visitor data.
        // The separate CSP warnings are assembled here from browser policy fields.
        delete event.message;
        for (var exception of event.exception.values || []) {
          exception.type = errorTypes.has(exception.type) ? exception.type : "Error";
          exception.value = "Browser error";
          if (exception.mechanism) delete exception.mechanism.data;
          if (!exception.stacktrace) continue;
          var frames = (exception.stacktrace.frames || []).flatMap(function (frame) {
            var filename = sourceFile(frame.filename);
            return filename ? [{ filename: filename, lineno: frame.lineno, colno: frame.colno, in_app: true }] : [];
          });
          if (frames.length) exception.stacktrace = { frames: frames };
          else delete exception.stacktrace;
        }
      }
      return event;
    }

    function report(item) {
      held.push(item);
      if (loading) return;
      loading = true;
      var s = document.createElement("script");
      s.src = sdkPolicy ? sdkPolicy.createScriptURL(sdkUrl) : sdkUrl;
      s.integrity = "{{ monitoring.sentrySdkIntegrity }}";
      s.onload = function () {
        Sentry.init({
          dsn: {{ monitoring.sentryDsnJson | safe }},
          release: "{{ siteRevision }}",
          // SDK 11 collects these by default; userInfo would let Sentry infer the visitor's IP.
          dataCollection: {
            userInfo: false,
            cookies: false,
            httpHeaders: { request: false, response: false },
            httpBodies: [],
            urlQueryParams: false
          },
          // A report carries a stack trace only when the error itself has one, as in SDK 10.
          attachStacktrace: false,
          sendClientReports: false,
          transportOptions: { fetchOptions: { referrerPolicy: "no-referrer" } },
          defaultIntegrations: false,
          integrations: [
            Sentry.eventFiltersIntegration(),
            Sentry.functionToStringIntegration(),
            Sentry.browserApiErrorsIntegration(),
            Sentry.globalHandlersIntegration(),
            Sentry.linkedErrorsIntegration(),
            Sentry.dedupeIntegration()
          ],
          beforeSend: minimizeReport
        });
        Sentry.setTag("site", "waseemilyas.uk");
        Sentry.setTag("deployment", "github-pages");
        // The SDK now catches errors itself.
        removeEventListener("error", onError);
        removeEventListener("unhandledrejection", onRejection);
        report = function (item) { send(item); };
        held.forEach(send);
        held = [];
      };
      document.head.appendChild(s);
    }
    addEventListener("error", onError);
    addEventListener("unhandledrejection", onRejection);
    // Anything the Content Security Policy blocks is reported once per page, so a
    // policy that stops part of the site shows up in Sentry. Browser extensions and
    // Sentry's own requests are skipped: neither is the site's to fix.
    var seen = new Set();
    addEventListener("securitypolicyviolation", function (e) {
      var blocked = e.blockedURI || "inline";
      var extension = /^(chrome|moz|safari(-web)?)-extension:/;
      if (extension.test(blocked) || extension.test(e.sourceFile || "") || /sentry/.test(blocked)) return;
      var description = /^(inline|eval|wasm-eval|trusted-types-(sink|policy))$/.test(blocked) ? blocked : sourceFile(blocked) || "resource";
      var line = "CSP blocked " + e.effectiveDirective + " " + description;
      if (seen.has(line)) return;
      seen.add(line);
      report(function () { Sentry.captureMessage(line, "warning"); });
    });
  })();
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Waseem Ilyas",
  "url": "{{ site.url }}",
  "email": "mailto:{{ site.email }}",
  "jobTitle": "Automation practitioner",
  "worksFor": { "@type": "Organization", "name": "Automancer", "url": "{{ site.automancer }}" },
  "sameAs": ["{{ site.github }}", "{{ site.automancer }}"]
}
</script>
{%- if isNote %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDesc | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "url": "{{ canonical }}",
  "mainEntityOfPage": "{{ canonical }}",
  "image": "{{ ogImage }}",
  "inLanguage": "en-GB",
  "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.url }}/about/" }
}
</script>
{%- endif %}
</head>
<body{% if isNote or "casestudy" in (tags or []) %} class="reading-page"{% endif %}>
<a class="skip" href="#main">Skip to content</a>

<header class="topbar">
  <div class="shell">
    <a class="wordmark" href="/">Waseem Ilyas<b>.</b></a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="primary-nav" popovertarget="primary-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary" popover>
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      <a class="cta" href="{{ site.email | mailto }}">Email</a>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer class="console foot">
  <div class="shell">
    <div>
      <div class="meta">Waseem Ilyas · Automancer · United Kingdom</div>
      <div class="meta"><a href="{{ site.email | mailto }}">{{ site.email }}</a> · <a href="{{ site.github }}" rel="me noopener">GitHub</a></div>
    </div>
    <nav class="fnav" aria-label="Footer">
      {%- for item in site.nav %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</footer>

<script src="/assets/js/site.js" defer></script>
<!-- Fetch an article early when its link is the reader's likely next step: a case-study card
     on Home or Work, a note on Notes, or the Next link. Keep full prerendering on stronger link intent. -->
<script type="speculationrules">
{
  "prefetch": [{
    "where": { "and": [{ "href_matches": "/*" }, { "selector_matches": "a.nextread[href$=\"/\"], a.workcard[href$=\"/\"], .workcard h2 a[href$=\"/\"], .note-item h2 a[href$=\"/\"]" }] },
    "eagerness": "eager"
  }],
  "prerender": [{
    "where": { "and": [{ "href_matches": "/*" }, { "selector_matches": "a[href$=\"/\"]" }] },
    "eagerness": "moderate"
  }]
}
</script>
</body>
</html>
