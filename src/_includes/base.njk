<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="strict-origin-when-cross-origin">
<script>document.documentElement.className+=' js';</script>

{% set pageTitle = title if title else site.shortTitle %}
{% set fullTitle = pageTitle + " — " + site.shortTitle if title and page.url != "/" else site.title %}
{% set pageDesc = description if description else site.description %}
{% set canonical = site.url + page.url %}
{#- The share-card transform fills article image metadata from the rendered page. #}
{% set ogImage = site.url + site.ogImage %}
{% set ogImageAlt = site.ogImageAlt %}
{% set isNote = "note" in (tags or []) %}

<title>{{ fullTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="author" content="{{ site.author }}">
<meta name="waseemilyas-revision" content="{{ siteRevision }}">
<meta name="theme-color" content="#2b2622">

<!-- Open Graph -->
<meta property="og:type" content="{{ "article" if isNote else "website" }}">
<meta property="og:site_name" content="{{ site.shortTitle }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogImageAlt }}">
{%- if isNote %}
<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:author" content="{{ site.url }}/about/">
{%- endif %}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImage }}">
<meta name="twitter:image:alt" content="{{ ogImageAlt }}">

<!-- Icons -->
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Fonts: self-hosted, preloaded -->
<link rel="preload" href="/assets/fonts/Geist-Latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/GeistMono-Latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/styles.css">
<link rel="alternate" type="application/atom+xml" title="{{ site.shortTitle }} — Notes" href="/notes/feed.xml">

{% if monitoring.sentryLoaderUrl %}
<!-- Error monitoring is configured only in production builds via SENTRY_DSN.
     The loader is fetched asynchronously so a third-party origin never blocks
     first paint; errors raised before it arrives are held and reported once it
     does. The loader stays lazy: the SDK bundle downloads only after an error. -->
<script>
  window.sentryOnLoad = function () {
    Sentry.init({ dsn: {{ monitoring.sentryDsnJson | safe }}, release: "{{ siteRevision }}" });
    Sentry.setTag("site", "waseemilyas.uk");
    Sentry.setTag("deployment", "github-pages");
  };
  (function () {
    var early = [];
    var hold = function (e) { early.push(e.error || e.reason || e.message); };
    addEventListener("error", hold);
    addEventListener("unhandledrejection", hold);
    // Anything the Content Security Policy blocks is reported once per page, so a
    // policy that stops part of the site shows up in Sentry. Browser extensions and
    // Sentry's own requests are skipped: neither is the site's to fix.
    var seen = {};
    addEventListener("securitypolicyviolation", function (e) {
      var line = "CSP blocked " + e.effectiveDirective + " " + (e.blockedURI || "inline").replace(/[?#].*/, "");
      if (seen[line] || /^(chrome|moz|safari(-web)?)-extension:|sentry/.test(e.blockedURI)) return;
      seen[line] = 1;
      var send = function () { Sentry.captureMessage(line, "warning"); };
      if (window.Sentry) send(); else early.push(send);
    });
    var s = document.createElement("script");
    s.src = "{{ monitoring.sentryLoaderUrl }}";
    s.crossOrigin = "anonymous";
    s.onload = function () {
      removeEventListener("error", hold);
      removeEventListener("unhandledrejection", hold);
      early.forEach(function (item) { typeof item === "function" ? item() : Sentry.captureException(item); });
    };
    document.head.appendChild(s);
  })();
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Waseem Ilyas",
  "url": "{{ site.url }}",
  "email": "mailto:{{ site.email }}",
  "jobTitle": "Automation practitioner",
  "worksFor": { "@type": "Organization", "name": "Automancer", "url": "{{ site.automancer }}" },
  "sameAs": ["{{ site.github }}", "{{ site.automancer }}"]
}
</script>
{%- if isNote %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDesc | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "url": "{{ canonical }}",
  "mainEntityOfPage": "{{ canonical }}",
  "image": "{{ ogImage }}",
  "inLanguage": "en-GB",
  "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.url }}/about/" }
}
</script>
{%- endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="topbar">
  <div class="shell">
    <a class="wordmark" href="/">Waseem Ilyas<b>.</b></a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="primary-nav" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
    </button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      <a class="cta" href="{{ site.email | mailto }}">Email</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="console foot">
  <div class="shell">
    <div>
      <div class="meta">Waseem Ilyas · Automancer · United Kingdom</div>
      <div class="meta"><a href="{{ site.email | mailto }}">{{ site.email }}</a> · <a href="{{ site.github }}" rel="me noopener">GitHub</a></div>
    </div>
    <nav class="fnav" aria-label="Footer">
      {%- for item in site.nav %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</footer>

<script src="/assets/js/site.js" defer></script>
</body>
</html>
