---
layout: base.njk
---
<article class="essay section" aria-labelledby="case-title">
  <div class="shell">
    <div class="casehead" data-cal="0">
      <span class="ref">{{ ref }}</span>
      <h1 id="case-title">{{ title }}</h1>
      <p class="kick">{{ kicker }}</p>
    </div>

    <div class="casegrid">
      <div class="prose" data-cal="1">
        {{ content | safe }}
      </div>

      <aside class="datasheet" data-cal="2" aria-label="Case datasheet">
        <div class="dh">Datasheet</div>
        <dl>
          {%- for row in datasheet %}
          <dt>{{ row.k }}</dt><dd>{{ row.v | safe }}</dd>
          {%- endfor %}
        </dl>
      </aside>
    </div>

    {%- set next = collections.casestudies | getNextCollectionItem(page) or collections.casestudies | first %}
    {%- if next and next.url != page.url %}
    <a class="nextread" href="{{ next.url }}" data-cal>
      <span class="nextread-k">Next case study · {{ next.data.ref }}</span>
      <span class="nextread-t">{{ next.data.title }}</span>
      <span class="nextread-d">{{ next.data.kicker }}</span>
      <span class="nextread-go" aria-hidden="true">→</span>
    </a>
    {%- endif %}

    <nav class="casenav" aria-label="Case study">
      <a href="/work/">← All work</a>
      <a href="{{ site.email | mailto('About your case study: ' + title) }}">Email Waseem →</a>
    </nav>
    {% include "partials/print-source.njk" %}
  </div>
</article>
