---
layout: base.njk
---
<article class="essay section" aria-labelledby="note-title">
  <div class="shell">
    <div class="casehead" data-cal="0">
      <span class="ref">NOTES</span>
      <h1 id="note-title">{{ title }}</h1>
      <p class="kick"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if summary %} · {{ summary }}{% endif %}</p>
    </div>
    <div class="prose" data-cal="1">
      {{ content | safe }}
    </div>
    {%- set next = collections.notes | getNextCollectionItem(page) or collections.notes | first %}
    {%- if next and next.url != page.url %}
    <a class="nextread" href="{{ next.url }}" data-cal>
      <span class="nextread-k">Next note · <time datetime="{{ next.date | isoDate }}">{{ next.date | readableDate }}</time></span>
      <span class="nextread-t">{{ next.data.title }}</span>
      <span class="nextread-d">{{ next.data.summary }}</span>
      <span class="nextread-go" aria-hidden="true">→</span>
    </a>
    {%- endif %}
    <nav class="casenav" aria-label="Notes">
      <a href="/notes/">← All notes</a>
      <a href="{{ site.email | mailto('About your note: ' + title) }}">Email Waseem →</a>
    </nav>
    {% include "partials/print-source.njk" %}
  </div>
</article>
