<figure class="diagram-panel">
  <svg viewBox="0 0 452 228" role="img" aria-label="Abstract automation workflow: a signal passes through scope, design, and build stages into a running system. Generated diagram, no client data.">
    <defs>
      <marker id="wf-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path class="wf-arrowhead" d="M0,0 L6,3 L0,6 Z"/>
      </marker>
    </defs>
    <!-- traces -->
    <g class="wf-trace" fill="none" stroke-width="1.6" marker-end="url(#wf-arrow)">
      <path d="M82,60 C110,60 110,60 140,60"/>
      <path d="M232,60 C262,60 262,114 290,114"/>
      <path d="M140,60 C112,100 112,128 140,168"/>
      <path d="M232,168 C262,168 262,114 286,114"/>
    </g>
    <!-- nodes: drawn near 1:1 with the panel, so labels read at 14px or more -->
    <g font-family="Geist Mono, monospace" font-size="14" letter-spacing="0.04em">
      <g class="wf-node">
        <rect x="10" y="40" width="72" height="40" rx="9" stroke="oklch(1 0 0 / 0.18)"/>
        <text x="46" y="65" text-anchor="middle">INPUT</text>
      </g>
      <g class="wf-node">
        <rect x="140" y="40" width="92" height="40" rx="9" stroke="oklch(1 0 0 / 0.18)"/>
        <text x="186" y="65" text-anchor="middle">SCOPE</text>
      </g>
      <g class="wf-node">
        <rect x="140" y="148" width="92" height="40" rx="9" stroke="oklch(1 0 0 / 0.18)"/>
        <text x="186" y="173" text-anchor="middle">DESIGN</text>
      </g>
      <g class="wf-node-live">
        <rect x="290" y="94" width="152" height="40" rx="9"/>
        <text x="366" y="119" text-anchor="middle" fill="oklch(0.80 0.13 50)">RUNNING SYSTEM</text>
      </g>
    </g>
    <!-- tick marks -->
    <g class="wf-ticks" stroke-width="1">
      <line x1="10" y1="212" x2="442" y2="212"/>
      <line x1="46" y1="208" x2="46" y2="216"/>
      <line x1="186" y1="208" x2="186" y2="216"/>
      <line x1="366" y1="208" x2="366" y2="216"/>
    </g>
  </svg>
  <div class="diagram-phone" role="img" aria-label="Abstract automation workflow: a signal passes through scope, design, and build stages into a running system. Generated diagram, no client data.">
    <div class="dflow">
      <span class="dnode">INPUT</span>
      <span class="djoin" aria-hidden="true"></span>
      <span class="dnode">SCOPE</span>
      <span class="djoin" aria-hidden="true"></span>
      <span class="dnode">DESIGN</span>
      <span class="djoin" aria-hidden="true"></span>
      <span class="dnode dnode-live">RUNNING SYSTEM</span>
    </div>
  </div>
</figure>
