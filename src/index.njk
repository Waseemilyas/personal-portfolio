---
layout: base.njk
title: false
description: "Waseem Ilyas runs Automancer, a UK automation consultancy helping small businesses use AI and practical digital systems. A long career across web, design, instructional design, and product delivery."
---

<!-- ========== HERO (console) ========== -->
<section class="console hero" aria-label="Introduction">
  <span class="reg tl" aria-hidden="true"></span><span class="reg tr" aria-hidden="true"></span>
  <span class="reg bl" aria-hidden="true"></span><span class="reg br" aria-hidden="true"></span>
  <div class="shell">
    <div>
      <p class="eyebrow" data-cal="0"><span class="dot" aria-hidden="true"></span><span class="mono label">WASEEM ILYAS / UK</span></p>
      <h1 data-cal="1">Technologist who designs, builds, teaches, and <em>automates</em>.</h1>
      <p class="lede" data-cal="2">I run Automancer, a UK automation consultancy helping small businesses get real value from AI and practical digital systems. Before that: front-end web, instructional design, and fifteen-plus years of making digital things.</p>
      <div class="actions" data-cal="3">
        <a class="btn btn-primary" href="{{ site.email | mailto }}">Email Waseem →</a>
        <a class="btn btn-ghost" href="#work">Read the work ↓</a>
      </div>
    </div>

    <section class="panel" data-cal="4" aria-label="Current status">
      <div class="phead">
        <span class="mono label">STATUS</span>
        <span class="live mono"><span class="blip" aria-hidden="true"></span>LIVE</span>
      </div>
      <dl>
        <div class="readout"><dt>NOW</dt><dd>Building Automancer · AI + automation for small businesses</dd></div>
        <div class="readout"><dt>BASE</dt><dd>United Kingdom</dd></div>
        <div class="readout"><dt>SINCE</dt><dd>Designing and building on the web since age 15</dd></div>
        <div class="readout"><dt>STACK</dt><dd>AI / automation · web / product · learning design · creative</dd></div>
      </dl>
    </section>
  </div>
</section>

<!-- ========== SELECTED WORK (console) ========== -->
<section class="console section" aria-labelledby="work">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">WORK·01</span>
      <h2 id="work" tabindex="-1">Selected work</h2>
      <p>A few projects where the mix mattered more than any single skill. Some are public. Some are anonymised to protect client privacy.</p>
    </div>
    <div class="worklist" data-cal>
      {%- for cs in collections.casestudies %}
      <a class="workcard" href="{{ cs.url }}" data-prefetch-article>
        <span class="ref">{{ cs.data.ref }}</span>
        <div><h3>{{ cs.data.title }}</h3><span class="kick">{{ cs.data.kicker }}</span></div>
        <span class="go">Read →</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ========== CAPABILITY MAP (console) ========== -->
<section class="console section" id="capability" aria-label="Capability map">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">MAP·02</span>
      <h2>What I actually do</h2>
      <p>{{ capabilities.intro }}</p>
    </div>

    <div class="cap" data-cal>
      <figure class="capfig" hidden>
        <svg class="cap-settled" viewBox="0 0 720 454">
          <g id="traces" stroke-linecap="round" aria-hidden="true">
            {%- for n in capabilities.nodes %}
            <path class="trace" data-for="{{ n.key }}" d="{{ n.trace }}"/>
            {%- endfor %}
          </g>
          <g class="hub" aria-hidden="true">
            <circle cx="360" cy="220" r="56"/>
            <text x="360" y="226" text-anchor="middle">PRACTICE</text>
          </g>
          <g role="tablist" aria-label="Capabilities">
            {%- for n in capabilities.nodes %}
            <g class="node" role="tab" aria-label="{{ n.title }}" aria-controls="cap-{{ n.key }}"
               data-key="{{ n.key }}" transform="translate({{ n.x }},{{ n.y }})">
              <circle class="ring" r="32"></circle><circle class="core" r="6"></circle>
              <text x="0" y="{{ n.textY }}" text-anchor="middle">{{ n.title }}</text>
            </g>
            {%- endfor %}
          </g>
        </svg>
        <div class="cap-phone">
          <p class="cap-phone-hub" aria-hidden="true">PRACTICE</p>
          <div class="cap-phone-grid" role="tablist" aria-label="Capabilities">
            {%- for n in capabilities.nodes %}
            <button type="button" class="node" role="tab" aria-controls="cap-{{ n.key }}" data-key="{{ n.key }}">{{ n.title }}</button>
            {%- endfor %}
          </div>
        </div>
      </figure>

      <div class="cap-panels">
        {%- set reading = collections.notes.concat(collections.casestudies) %}
        {%- for n in capabilities.nodes %}
        <div class="capread" id="cap-{{ n.key }}">
          <span class="k" aria-hidden="true">{{ n.code }}</span>
          <h3 id="cap-title-{{ n.key }}">{{ n.title }}</h3>
          <p>{{ n.body }}</p>
          {%- if n.reading %}
            {%- for item in reading %}
              {%- if item.url == n.reading and not item.data.draft %}
          <a class="cap-link" href="{{ item.url }}">
            <span>{{ item.data.title }}</span>
            <span aria-hidden="true">→</span>
          </a>
              {%- endif %}
            {%- endfor %}
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

<!-- ========== AUTOMANCER (console) ========== -->
<section class="console section" id="automancer-teaser" aria-label="Automancer">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">AUTO·03</span>
      <h2>Automancer</h2>
      <p>AI and practical digital systems for small businesses, without enterprise overhead.</p>
    </div>
    <div class="amancer" data-cal>
      <div class="body">
        <p>Automancer is my automation consultancy. I help small businesses benefit from AI and practical digital systems, without the cost and complexity of enterprise software.</p>
        <p class="note-line">The work is hands-on: scope the real problem, design a lightweight system, and build it.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/automancer/">About Automancer →</a>
          <a class="btn btn-ghost" href="{{ site.automancer }}" rel="noopener">Visit automancer.uk ↗</a>
        </div>
      </div>
      {% include "partials/diagram-workflow.njk" %}
    </div>
  </div>
</section>

<!-- ========== THE ARC (console) ========== -->
<section class="console section" id="arc" aria-label="Career arc">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">ARC·04</span>
      <h2>The arc</h2>
      <p>{{ timeline.intro }}</p>
    </div>
    <div class="arc arc-line" data-cal>
      {%- for m in timeline.milestones %}
      <div class="milestone{% if m.proof %} key{% endif %}">
        <span class="era">{{ m.era }}</span>
        <h3>{{ m.label }}</h3>
        <p>{{ m.body }}</p>
        {%- if m.proof %}
        <ul class="proof">
          {%- for line in m.proof %}<li>{{ line }}</li>{%- endfor %}
        </ul>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ========== LAB TEASER (console) ========== -->
<section class="console section" id="lab-teaser" aria-label="Lab">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">LAB·05</span>
      <h2>Lab</h2>
      <p>Public projects, prototypes, and things built to find out whether they would work.</p>
    </div>
    <div class="lab-grid" data-cal>
      <a class="lab-card" href="{{ site.automancer }}" rel="noopener">
        <span class="tag">PUBLIC · SITE</span>
        <h3>Automancer site</h3>
        <p>The consultancy's public website.</p>
        <span class="ext">automancer.uk ↗</span>
      </a>
      <a class="lab-card" href="/work/cs-product/">
        <span class="tag">PUBLIC · PRODUCT</span>
        <h3>Public web product</h3>
        <p>A live product for a professional-services firm.</p>
        <span class="ext">/work/cs-product →</span>
      </a>
      <a class="lab-card" href="/lab/">
        <span class="tag">INDEX</span>
        <h3>All experiments</h3>
        <p>The full lab index.</p>
        <span class="ext">/lab →</span>
      </a>
    </div>
  </div>
</section>

<!-- ========== NOTES (console) ========== -->
{%- set latestNotes = collections.notes.slice(0, 3) %}
{%- if latestNotes.length %}
<section class="console section" id="notes-teaser" aria-labelledby="notes-title">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">NOTES·06</span>
      <h2 id="notes-title">Notes</h2>
      <p>Occasional writing on AI, automation, and building useful things.</p>
    </div>
    <div class="worklist" data-cal>
      {%- for note in latestNotes %}
      <a class="workcard notecard" href="{{ note.url }}">
        <span class="ref"><time datetime="{{ note.date | isoDate }}">{{ note.date | shortDate }}</time><span class="read-time">{{ note.data.readingMinutes }} min read</span></span>
        <div><h3>{{ note.data.title }}</h3>{%- if note.data.summary %}<span class="kick">{{ note.data.summary }}</span>{%- endif %}</div>
        <span class="go">Read →</span>
      </a>
      {%- endfor %}
    </div>
    <p class="section-more" data-cal><a href="/notes/"><span>All notes</span><span aria-hidden="true">→</span></a></p>
  </div>
</section>
{%- endif %}

<!-- ========== CONTACT (console) ========== -->
<section class="console section" id="contact-teaser" aria-label="Contact">
  <div class="shell">
    <div class="section-head" data-cal>
      <span class="ref">SAY·07</span>
      <h2>Get in touch</h2>
    </div>
    <div class="contact-cta" data-cal>
      <p class="contact-close">The fastest way to reach me is email. If you run a small business and want to know whether AI or automation is worth it for you, that is exactly the conversation I like having.</p>
      {% include "partials/email-cta.njk" %}
      <p class="contact-close">No funnel, no pitch deck. Just send a note. <span class="contact-alt">· <a href="{{ site.github }}" rel="me noopener">GitHub ↗</a></span></p>
    </div>
  </div>
</section>
